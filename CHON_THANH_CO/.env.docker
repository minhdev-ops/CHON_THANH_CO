# ═══════════════════════════════════════════════════════════════════════
# CHON THANH CO — .env cho Docker Compose
# Copy file này thành .env (hoặc để docker-compose đọc trực tiếp qua env_file)
# ═══════════════════════════════════════════════════════════════════════

APP_NAME="CHON THANH CO."
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=chon_thanh_co
DB_USERNAME=chon_thanh_co
DB_PASSWORD=chon_thanh_co

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="chonthanhco@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
AWS_BUCKET=CHON_THANH
AWS_ENDPOINT=https://htqmpwpewhfknqhgjhwp.storage.supabase.co/storage/v1/s3
AWS_URL=https://htqmpwpewhfknqhgjhwp.storage.supabase.co/storage/v1/object/public/CHON_THANH
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

ADMIN_PATH="admin"
ADMIN_EMAIL="admin@chonthanhco.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# MySQL root (chỉ dùng nội bộ container)
DB_ROOT_PASSWORD=rootpassword

# Supabase (giữ nguyên nếu dùng lưu file ảnh)
SUPABASE_URL=https://htqmpwpewhfknqhgjhwp.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://htqmpwpewhfknqhgjhwp.storage.supabase.co/auth/v1/.well-known/jwks.json
